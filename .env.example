# DEV ONLY. Optional: copy to .env in the repository root.
# No production mode or real credentials in I-001.
VPN_ENVIRONMENT=local
# Separate approved server configuration: docs/runbooks/closed-control-plane.md.
VPN_PUBLIC_ORIGIN=
VPN_ENABLE_API_DOCS=false
# I-023: separate administrative identity, never enabled by default.
VPN_ENABLE_ADMIN=false
VPN_CLOSED_ADMIN_ONLY=false
VPN_ADMIN_ENCRYPTION_KEY=

# Optional local PostgreSQL URL for Alembic; leave empty to run liveness-only API.
# Format: postgresql+psycopg://vpn_dev:<URL-encoded-local-password>@127.0.0.1:15432/vpn_dev
# Set the actual value only in ignored .env; query parameters/remote hosts are rejected.
VPN_DATABASE_URL=

# Required only for the optional local Compose services (not a default test password).
# Replace locally with a random value of at least 24 characters; never commit .env.
VPN_DEV_POSTGRES_PASSWORD=

# Optional LOCAL authentication. Keep false until all values are set privately.
VPN_ENABLE_AUTH=false
# I-017: enable only after local configuration; no automatic public deployment.
VPN_ENABLE_MINI_APP=false
# Absolute path to apps/telegram-mini-app/dist after npm ci + npm run build.
VPN_MINI_APP_STATIC_DIR=
# Independent random secrets, each 43-128 URL-safe characters, generated locally.
VPN_AUTH_PEPPER=
VPN_TELEGRAM_WEBHOOK_SECRET=
# Configure an existing test bot locally; do not paste the token in chat/history.
VPN_TELEGRAM_BOT_TOKEN=
VPN_TELEGRAM_BOT_ID=0
VPN_TELEGRAM_BOT_USERNAME=

# Initial quota in integer bytes, once per account at successful code login.
# Default 0: no economic amount has been approved. Changes do not re-grant old accounts.
VPN_INITIAL_QUOTA_BYTES=0
