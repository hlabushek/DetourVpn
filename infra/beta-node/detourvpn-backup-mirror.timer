[Unit]
Description=Copy the encrypted DetourVpn beta backup to this host once per day

[Timer]
# The API host creates its archive at about 03:17 UTC (up to 20 minutes of random delay).
OnCalendar=*-*-* 04:30:00 UTC
RandomizedDelaySec=10min
Persistent=true
Unit=detourvpn-backup-mirror.service

[Install]
WantedBy=timers.target
