[Unit]
Description=DetourVpn isolated beta v3 window agent
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/opt/detourvpn-node /var/lib/detourvpn-node
Requires=detourvpn-beta-slot-bootstrap.service
BindsTo=detourvpn-beta-slot-bootstrap.service
After=detourvpn-beta-slot-bootstrap.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/detourvpn-node
ExecStart=/opt/detourvpn-node/.venv/bin/python /opt/detourvpn-node/window_daemon.py
ExecStartPre=/opt/detourvpn-node/.venv/bin/python /opt/detourvpn-node/beta_node_preflight.py
ExecCondition=/usr/bin/test -f /etc/detourvpn-node/agent.json
ExecCondition=/usr/bin/test -f /etc/detourvpn-node/credential
ExecCondition=/usr/bin/test -f /etc/detourvpn-node/slots.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
StateDirectory=detourvpn-node
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/run/detourvpn-node /var/lib/detourvpn-node
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
