{
  "$id": "urn:project-vpn:usage-result.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "delta_bytes": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Delta Bytes",
      "type": "integer"
    },
    "pending_bytes": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Pending Bytes",
      "type": "integer"
    },
    "quota_operation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quota Operation Id"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "insufficient_quota",
            "quota_capacity_exceeded",
            "counter_regression",
            "timestamp_regression",
            "outside_epoch",
            "future_sample",
            "stale_conflict"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "sample_id": {
      "format": "uuid",
      "title": "Sample Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "charged",
        "blocked",
        "no_change",
        "stale",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "sample_id",
    "status",
    "reason",
    "delta_bytes",
    "pending_bytes",
    "quota_operation_id"
  ],
  "title": "UsageResult",
  "type": "object"
}
