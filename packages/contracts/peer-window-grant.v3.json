{
  "$id": "urn:project-vpn:peer-window-grant.v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget_bytes": {
      "maximum": 67108864,
      "minimum": 65536,
      "title": "Budget Bytes",
      "type": "integer"
    },
    "connection_id": {
      "format": "uuid",
      "title": "Connection Id",
      "type": "string"
    },
    "contract_version": {
      "default": 3,
      "maximum": 3,
      "minimum": 3,
      "title": "Contract Version",
      "type": "integer"
    },
    "generation": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "node_id": {
      "format": "uuid",
      "title": "Node Id",
      "type": "string"
    },
    "not_after": {
      "format": "date-time",
      "title": "Not After",
      "type": "string"
    },
    "public_key": {
      "maxLength": 44,
      "minLength": 44,
      "title": "Public Key",
      "type": "string"
    },
    "runtime_id": {
      "format": "uuid",
      "title": "Runtime Id",
      "type": "string"
    },
    "slot_id": {
      "maximum": 16,
      "minimum": 1,
      "title": "Slot Id",
      "type": "integer"
    },
    "window_id": {
      "format": "uuid",
      "title": "Window Id",
      "type": "string"
    }
  },
  "required": [
    "connection_id",
    "window_id",
    "node_id",
    "runtime_id",
    "slot_id",
    "generation",
    "public_key",
    "issued_at",
    "not_after",
    "budget_bytes"
  ],
  "title": "WindowGrant",
  "type": "object"
}
