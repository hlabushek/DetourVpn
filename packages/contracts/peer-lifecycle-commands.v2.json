  "$id": "urn:project-vpn:peer-lifecycle-commands.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "commands": {
      "items": {
        "$ref": "#/$defs/LifecycleCommand"
