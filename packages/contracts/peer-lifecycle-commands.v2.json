          "type": "integer"
        },
        "public_key": {
          "title": "Public Key",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "peer_id",
        "peer_version",
        "operation",
        "public_key",
        "lease_deadline",
        "budget_bytes"
