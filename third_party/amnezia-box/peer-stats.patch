+package route
+
+import (
+	"net"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/experimental/libbox/platform"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-tun"
+	"github.com/sagernet/sing/common/control"
+)
+
+type initialInterfacesPlatform struct {
+	platform.Interface
+	interfaces []adapter.NetworkInterface
+}
+
+func (p initialInterfacesPlatform) Interfaces() ([]adapter.NetworkInterface, error) {
+	return p.interfaces, nil
+}
+
+type beforeCallbackMonitor struct {
+	tun.DefaultInterfaceMonitor
+	start func() error
+}
+
+func (m beforeCallbackMonitor) Start() error { return m.start() }
+
+func TestPlatformInterfacesReadyBeforeMonitorCallback(t *testing.T) {
+	physical := adapter.NetworkInterface{Interface: control.Interface{
+		Name: "physical-test", Index: 123, Flags: net.FlagUp,
+	}}
+	manager := &NetworkManager{
+		logger:              log.NewNOPFactory().Logger(),
+		interfaceFinder:     control.NewDefaultInterfaceFinder(),
+		autoDetectInterface: true,
+		platformInterface:   initialInterfacesPlatform{interfaces: []adapter.NetworkInterface{physical}},
+	}
+	manager.interfaceMonitor = beforeCallbackMonitor{start: func() error {
+		available := manager.NetworkInterfaces()
+		if len(available) != 1 || available[0].Index != physical.Index {
+			t.Fatal("physical interfaces were unavailable before monitor callback")
+		}
+		return nil
+	}}
+	if err := manager.Start(adapter.StartStateInitialize); err != nil {
+		t.Fatal(err)
+	}
+}
