+
+// PeerStatsJSON exposes only single-peer accounting fields to the mobile wrapper.
+// In particular, it never returns the UAPI document, which contains private keys.
+func (d *Device) PeerStatsJSON() (string, error) {
+	d.access.Lock()
+	defer d.access.Unlock()
+	if d.closed || d.awgDevice == nil {
+		return "", net.ErrClosed
+	}
+	state, err := d.awgDevice.IpcGet()
+	if err != nil {
+		return "", err
+	}
+	var peerCount int
+	var handshake, received, sent int64
+	scanner := bufio.NewScanner(strings.NewReader(state))
+	for scanner.Scan() {
+		key, value, found := strings.Cut(scanner.Text(), "=")
+		if !found {
+			continue
+		}
+		switch key {
+		case "public_key":
+			peerCount++
+		case "last_handshake_time_sec":
+			handshake, err = strconv.ParseInt(value, 10, 64)
+		case "rx_bytes":
+			received, err = strconv.ParseInt(value, 10, 64)
+		case "tx_bytes":
+			sent, err = strconv.ParseInt(value, 10, 64)
+		}
+		if err != nil {
+			return "", err
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return "", err
+	}
+	if peerCount != 1 || handshake < 0 || received < 0 || sent < 0 {
+		return "", fmt.Errorf("unexpected AWG peer stats shape")
+	}
+	return fmt.Sprintf(`{"peer_count":%d,"last_handshake_time_sec":%d,"rx_bytes":%d,"tx_bytes":%d}`,
+		peerCount, handshake, received, sent), nil
+}

