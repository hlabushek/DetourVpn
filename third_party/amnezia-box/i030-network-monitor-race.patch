diff --git a/experimental/libbox/monitor_race_test.go b/experimental/libbox/monitor_race_test.go
new file mode 100644
--- /dev/null
+++ b/experimental/libbox/monitor_race_test.go
@@ -0,0 +1,35 @@
+package libbox
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/sagernet/sing/common/control"
+)
+
+func TestNetworkCostSnapshot(t *testing.T) {
+	wrapper := &platformInterfaceWrapper{defaultInterface: &control.Interface{Index: 4}}
+	wrapper.setNetworkCost(true, true)
+	if expensive, constrained := wrapper.networkCost(4, false); !expensive || !constrained {
+		t.Fatalf("default interface policy = (%v, %v), want (true, true)", expensive, constrained)
+	}
+	if expensive, constrained := wrapper.networkCost(5, true); !expensive || constrained {
+		t.Fatalf("metered non-default policy = (%v, %v), want (true, false)", expensive, constrained)
+	}
+}
+
+func TestNetworkCostConcurrentSnapshot(t *testing.T) {
+	wrapper := new(platformInterfaceWrapper)
+	var workers sync.WaitGroup
+	for worker := 0; worker < 8; worker++ {
+		workers.Add(1)
+		go func(seed bool) {
+			defer workers.Done()
+			for i := 0; i < 10_000; i++ {
+				wrapper.setNetworkCost(seed, !seed)
+				wrapper.networkCost(4, false)
+			}
+		}(worker%2 == 0)
+	}
+	workers.Wait()
+}
