+	w.defaultInterfaceAccess.Lock()
+	defer w.defaultInterfaceAccess.Unlock()
+	isDefault := w.defaultInterface != nil && interfaceIndex == w.defaultInterface.Index
+	return metered || isDefault && w.isExpensive, isDefault && w.isConstrained
